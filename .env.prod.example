# 云服务器生产环境配置：复制为 .env 放在服务器项目根目录
# 生成随机串：openssl rand -hex 32

# 你的域名（解析到这台服务器，Caddy 会自动申请 HTTPS 证书）
DOMAIN=jizhang.example.com

# MySQL（容器内网，不对外暴露）
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=jizhang
MYSQL_USER=jizhang
MYSQL_PASSWORD=change-me-strong

# 服务端
JWT_SECRET=change-me-64-hex
PORT=8787
TZ=Asia/Shanghai

# 单用户固定账号
DEFAULT_USERNAME=owner
DEFAULT_PASSWORD=change-me-strong-password

# 快捷指令 OCR 通道令牌
INGEST_TOKEN=ing_change-me-random
