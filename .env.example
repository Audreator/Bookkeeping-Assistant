# 复制为 .env 并修改全部 change-me 值
# MySQL（docker compose 使用）
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=jizhang
MYSQL_USER=jizhang
MYSQL_PASSWORD=change-me

# 服务端
DATABASE_URL=mysql://jizhang:change-me@127.0.0.1:3306/jizhang
TEST_DATABASE_URL=mysql://jizhang:change-me@127.0.0.1:3306/jizhang_test
JWT_SECRET=change-me-long-random-string
PORT=8787
TZ=Asia/Shanghai

# 单用户固定账号（可选；设置后启动时自动创建/校正密码，注册默认关闭）
DEFAULT_USERNAME=owner
DEFAULT_PASSWORD=change-me-strong-password

# 邮件自动记账（可选；填好后启动服务器自动轮询银行通知邮件）
IMAP_HOST=imap.qq.com
IMAP_USER=
IMAP_PASS=
BANK_SENDER_FILTER=cmbchina.com
AUTO_EMAIL_USER=
EMAIL_POLL_SECONDS=60

# 快捷指令 OCR 通道（快捷指令请求头 x-ingest-token 使用，随便设一串长随机字符）
INGEST_TOKEN=
# 可选，固定入账用户 ID；省略时取第一个用户
INGEST_USER=
